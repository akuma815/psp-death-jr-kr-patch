    {
      "file": "GAMEINTRO.mp4",
      "source_sha256": "299ac0fef830653cd51034c15f7493111cd875fda0204375f72fd9a57b65518f",
      "output_sha256": "d45c32b683d1931a4352eda1de8996003bce1347edb47a6e42c9612414d834bc",
      "frames": 5478,
      "cues": 48,
      "decode": "PASS",
      "audio_packet_hash": "SHA256=be837750ed7fa9f26319d9c514a098e1e3be67cabfee73518b34d64c7d035030",
      "cue_layout": [
        {
          "id": "GAMEINTRO_001",
          "lines": [
            "얘들아, 줄 서서 들어가. 보고서는 오늘 안에 내고."
          ],
          "start_ms": 6060,
          "end_ms": 9920,
          "visible_frames": 116,
          "review_status": "asr_compared"
        },
        {
          "id": "GAMEINTRO_002",
          "lines": [
            "서둘러, 몰리."
          ],
          "start_ms": 10000,
          "end_ms": 10940,
          "visible_frames": 28,
          "review_status": "needs_review"
        },
        {
          "id": "GAMEINTRO_003",
          "lines": [
            "아이고, 맙소사."
          ],
          "start_ms": 15020,
          "end_ms": 16090,
          "visible_frames": 32,
          "review_status": "asr_compared"
        },
        {
          "id": "GAMEINTRO_004",
          "lines": [
            "자료실부터 둘러보자."
          ],
          "start_ms": 17400,
          "end_ms": 18560,
          "visible_frames": 35,
          "review_status": "asr_compared"
        },
        {
          "id": "GAMEINTRO_005",
          "lines": [
            "베키, 맥스 그만 때려."
          ],
          "start_ms": 18980,
          "end_ms": 20240,
          "visible_frames": 38,
          "review_status": "needs_review"
        },
        {
          "id": "GAMEINTRO_006",
          "lines": [
            "안녕!"
          ],
          "start_ms": 26500,
          "end_ms": 27200,
          "visible_frames": 21,
          "review_status": "needs_review"
        },
        {
          "id": "GAMEINTRO_007",
          "lines": [
            "반 애들이랑 같이 가야 해."
          ],
          "start_ms": 29020,
          "end_ms": 30840,
          "visible_frames": 55,
          "review_status": "asr_compared"
        },
        {
          "id": "GAMEINTRO_008",
          "lines": [
            "젠장."
          ],
          "start_ms": 31840,
          "end_ms": 32220,
          "visible_frames": 11,
          "review_status": "asr_compared"
        },
        {
          "id": "GAMEINTRO_009",
          "lines": [
            "괜히 긴장되잖아."
          ],
          "start_ms": 32760,
          "end_ms": 33680,
          "visible_frames": 28,
          "review_status": "asr_compared"
        },
        {
          "id": "GAMEINTRO_010",
          "lines": [
            "봤지?"
          ],
          "start_ms": 34880,
          "end_ms": 35280,
          "visible_frames": 12,
          "review_status": "asr_compared"
        },
        {
          "id": "GAMEINTRO_011",
          "lines": [
            "얘들아, 좀!"
          ],
          "start_ms": 36060,
          "end_ms": 37080,
          "visible_frames": 31,
          "review_status": "asr_compared"
        },
        {
          "id": "GAMEINTRO_012",
          "lines": [
            "그럼 난 뭘 보고 보고서를 쓰라고?"
          ],
          "start_ms": 37320,
          "end_ms": 39420,
          "visible_frames": 63,
          "review_status": "asr_compared"
        },
        {
          "id": "GAMEINTRO_013",
          "lines": [
            "오늘 못 배운 거라도 쓰라는 거야?"
          ],
          "start_ms": 39780,
          "end_ms": 41120,
          "visible_frames": 40,
          "review_status": "asr_compared"
        },
        {
          "id": "GAMEINTRO_014",
          "lines": [
            "넌 진짜 별로야, 스티그마사."
          ],
          "start_ms": 41660,
          "end_ms": 42820,
          "visible_frames": 35,
          "review_status": "asr_compared"
        },
        {
          "id": "GAMEINTRO_015",
          "lines": [
            "데드 구피는 겁도 안 먹잖아."
          ],
          "start_ms": 43160,
          "end_ms": 44460,
          "visible_frames": 39,
          "review_status": "asr_compared"
        },
        {
          "id": "GAMEINTRO_016",
          "lines": [
            "내가 뭐 어때서!"
          ],
          "start_ms": 46360,
          "end_ms": 47780,
          "visible_frames": 42,
          "review_status": "asr_compared"
        },
        {
          "id": "GAMEINTRO_017",
          "lines": [
            "이러다 또 잡혀갈 거야."
          ],
          "start_ms": 48040,
          "end_ms": 50000,
          "visible_frames": 59,
          "review_status": "asr_compared"
        },
        {
          "id": "GAMEINTRO_018",
          "lines": [
            "그 입 좀 막아."
          ],
          "start_ms": 50560,
          "end_ms": 51620,
          "visible_frames": 32,
          "review_status": "asr_compared"
        },
        {
          "id": "GAMEINTRO_019",
          "lines": [
            "이미 마개가 꽂혀 있는데."
          ],
          "start_ms": 52100,
          "end_ms": 53740,
          "visible_frames": 49,
          "review_status": "asr_compared"
        },
        {
          "id": "GAMEINTRO_020",
          "lines": [
            "으, 더러워!"
          ],
          "start_ms": 54130,
          "end_ms": 54860,
          "visible_frames": 22,
          "review_status": "needs_review"
        },
        {
          "id": "GAMEINTRO_021",
          "lines": [
            "역겨워!"
          ],
          "start_ms": 54860,
          "end_ms": 55850,
          "visible_frames": 29,
          "review_status": "asr_compared"
        },
        {
          "id": "GAMEINTRO_022",
          "lines": [
            "이 얘기도 지겹군."
          ],
          "start_ms": 56470,
          "end_ms": 57550,
          "visible_frames": 32,
          "review_status": "asr_compared"
        },
        {
          "id": "GAMEINTRO_023",
          "lines": [
            "우리 조 보고서는 네가 쓰겠다고 했잖아, 마티."
          ],
          "start_ms": 57770,
          "end_ms": 59870,
          "visible_frames": 63,
          "review_status": "asr_compared"
        },
        {
          "id": "GAMEINTRO_024",
          "lines": [
            "불평해 봐야 소용없어."
          ],
          "start_ms": 60070,
          "end_ms": 61070,
          "visible_frames": 30,
          "review_status": "asr_compared"
        },
        {
          "id": "GAMEINTRO_025",
          "lines": [
            "좀 더 흥미로운 놀 거리를 찾아보자."
          ],
          "start_ms": 61510,
          "end_ms": 63970,
          "visible_frames": 74,
          "review_status": "asr_compared"
        },
        {
          "id": "GAMEINTRO_026",
          "lines": [
            "저런 거!"
          ],
          "start_ms": 66060,
          "end_ms": 67090,
          "visible_frames": 31,
          "review_status": "asr_compared"
        },
        {
          "id": "GAMEINTRO_027",
          "lines": [
            "이런!"
          ],
          "start_ms": 69940,
          "end_ms": 70560,
          "visible_frames": 18,
          "review_status": "asr_compared"
        },
        {
          "id": "GAMEINTRO_028",
          "lines": [
            "수천 년 된 것으로 추정되는 유물."
          ],
          "start_ms": 72320,
          "end_ms": 75680,
          "visible_frames": 101,
          "review_status": "asr_compared"
        },
        {
          "id": "GAMEINTRO_029",
          "lines": [
            "개봉 시도는 모두 실패했다."
          ],
          "start_ms": 76100,
          "end_ms": 77660,
          "visible_frames": 47,
          "review_status": "asr_compared"
        },
        {
          "id": "GAMEINTRO_030",
          "lines": [
            "그 비밀은 영영 밝혀지지 않을지도 모른다."
          ],
          "start_ms": 78060,
          "end_ms": 79960,
          "visible_frames": 57,
          "review_status": "asr_compared"
        },
        {
          "id": "GAMEINTRO_031",
          "lines": [
            "오, 끝내주는데."
          ],
          "start_ms": 80220,
          "end_ms": 81120,
          "visible_frames": 27,
          "review_status": "asr_compared"
        },
        {
          "id": "GAMEINTRO_032",
          "lines": [
            "그만해, 판도라."
          ],
          "start_ms": 84140,
          "end_ms": 85580,
          "visible_frames": 43,
          "review_status": "asr_compared"
        },
        {
          "id": "GAMEINTRO_033",
          "lines": [
            "누가 잠갔든 다시 열리길 바라진 않았을 거야."
          ],
          "start_ms": 86040,
          "end_ms": 88960,
          "visible_frames": 88,
          "review_status": "asr_compared"
        },
        {
          "id": "GAMEINTRO_034",
          "lines": [
            "안 열려!"
          ],
          "start_ms": 91960,
          "end_ms": 93480,
          "visible_frames": 45,
          "review_status": "asr_compared"
        },
        {
          "id": "GAMEINTRO_035",
          "lines": [
            "이상하네. 난 뭐든 열 수 있는데."
          ],
          "start_ms": 94460,
          "end_ms": 96820,
          "visible_frames": 71,
          "review_status": "asr_compared"
        },
        {
          "id": "GAMEINTRO_036",
          "lines": [
            "재미없어. 그냥 시시한 상자잖아."
          ],
          "start_ms": 97400,
          "end_ms": 99400,
          "visible_frames": 60,
          "review_status": "asr_compared"
        },
        {
          "id": "GAMEINTRO_037",
          "lines": [
            "마티, 가자!"
          ],
          "start_ms": 99760,
          "end_ms": 100480,
          "visible_frames": 22,
          "review_status": "needs_review"
        },
        {
          "id": "GAMEINTRO_038",
          "lines": [
            "그러든가. 가자."
          ],
          "start_ms": 101240,
          "end_ms": 102380,
          "visible_frames": 34,
          "review_status": "needs_review"
        },
        {
          "id": "GAMEINTRO_039",
          "lines": [
            "이러다 외출 금지당할 거야."
          ],
          "start_ms": 104860,
          "end_ms": 106820,
          "visible_frames": 59,
          "review_status": "asr_compared"
        },
        {
          "id": "GAMEINTRO_040",
          "lines": [
            "그래, 알 게 뭐야. 담배 있는 사람?"
          ],
          "start_ms": 107140,
          "end_ms": 108660,
          "visible_frames": 46,
          "review_status": "asr_compared"
        },
        {
          "id": "GAMEINTRO_041",
          "lines": [
            "널 보러 다시 올게."
          ],
          "start_ms": 111800,
          "end_ms": 113780,
          "visible_frames": 59,
          "review_status": "asr_compared"
        },
        {
          "id": "GAMEINTRO_042",
          "lines": [
            "이랴!"
          ],
          "start_ms": 114140,
          "end_ms": 114840,
          "visible_frames": 21,
          "review_status": "needs_review"
        },
        {
          "id": "GAMEINTRO_043",
          "lines": [
            "A 받고 싶으면 나 좀 내버려 둬."
          ],
          "start_ms": 115760,
          "end_ms": 118060,
          "visible_frames": 69,
          "review_status": "needs_review"
        },
        {
          "id": "GAMEINTRO_044",
          "lines": [
            "야, DJ."
          ],
          "start_ms": 119000,
          "end_ms": 120520,
          "visible_frames": 45,
          "review_status": "needs_review"
        },
        {
          "id": "GAMEINTRO_045",
          "lines": [
            "방금 무슨 소리야?"
          ],
          "start_ms": 126180,
          "end_ms": 127420,
          "visible_frames": 37,
          "review_status": "needs_review"
        },
        {
          "id": "GAMEINTRO_046",
          "lines": [
            "뭐?"
          ],
          "start_ms": 127660,
          "end_ms": 128000,
          "visible_frames": 11,
          "review_status": "asr_compared"
        },
        {
          "id": "GAMEINTRO_047",
          "lines": [
            "나 아니야."
          ],
          "start_ms": 128320,
          "end_ms": 129280,
          "visible_frames": 29,
          "review_status": "asr_compared"
        },
        {
          "id": "GAMEINTRO_048",
          "lines": [
            "앗, 이번엔 나야."
          ],
          "start_ms": 131480,
          "end_ms": 133260,
          "visible_frames": 53,
          "review_status": "asr_compared"
        }
      ]
